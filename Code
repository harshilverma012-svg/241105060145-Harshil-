<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, #0f172a, #1e3a8a);
        min-height: 100vh;
        color: #1e293b;
    }

    .container {
        width: 95%;
        max-width: 1200px;
        margin: 30px auto;
    }

    .header {
        text-align: center;
        color: white;
        margin-bottom: 25px;
    }

    .header h1 {
        margin-bottom: 8px;
        font-size: 34px;
    }

    .header p {
        margin: 0;
        color: #cbd5e1;
    }

    .card {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .card h2 {
        margin-top: 0;
        color: #1e3a8a;
        border-bottom: 2px solid #e2e8f0;
        padding-bottom: 10px;
    }

    textarea {
        width: 100%;
        min-height: 120px;
        padding: 14px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        resize: vertical;
        font-size: 15px;
        margin-top: 8px;
    }

    button {
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 15px;
        font-weight: bold;
        margin: 8px 5px 8px 0;
        transition: 0.2s;
    }

    button:hover {
        transform: translateY(-1px);
        opacity: 0.9;
    }

    .primary {
        background: #2563eb;
        color: white;
    }

    .success {
        background: #16a34a;
        color: white;
    }

    .secondary {
        background: #475569;
        color: white;
    }

    .danger {
        background: #dc2626;
        color: white;
    }

    .process {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 20px;
    }

    .step {
        padding: 18px;
        border-radius: 10px;
        text-align: center;
        border: 2px solid #e2e8f0;
    }

    .step h3 {
        margin-top: 0;
    }

    .aes {
        background: #eff6ff;
        border-color: #60a5fa;
    }

    .rsa {
        background: #f5f3ff;
        border-color: #a78bfa;
    }

    .decrypt {
        background: #f0fdf4;
        border-color: #4ade80;
    }

    .output {
        background: #0f172a;
        color: #22c55e;
        padding: 15px;
        border-radius: 8px;
        margin-top: 10px;
        word-break: break-all;
        white-space: pre-wrap;
        font-family: Consolas, monospace;
        font-size: 13px;
        max-height: 220px;
        overflow-y: auto;
    }

    .label {
        font-weight: bold;
        margin-top: 15px;
        display: block;
        color: #334155;
    }

    .status {
        padding: 14px;
        border-radius: 8px;
        margin-top: 15px;
        font-weight: bold;
        display: none;
    }

    .status.success-status {
        display: block;
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
    }

    .status.error-status {
        display: block;
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }

    .key-info {
        background: #f8fafc;
        border-left: 4px solid #2563eb;
        padding: 12px;
        margin-top: 15px;
        font-size: 14px;
    }

    .badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #dbeafe;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: bold;
        margin: 3px;
    }

    @media (max-width: 800px) {
        .process {
            grid-template-columns: 1fr;
        }
    }
</style>
